{
  "name": "km_hudtest",
  "version": "0.5.8",
  "description": "HUD: Warmfahren und Öltemperatur im Head-up-Display",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 40,
    "memoryThresholdKB": 163840,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "KMHT",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "owner",
  "license": "SEE LICENSE IN LICENSE",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID8"
  ],
  "mguAppStartType": "autostart"
}
