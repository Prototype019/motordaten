{
  "name": "km_motordaten",
  "version": "0.33.0",
  "description": "M Suite: Motordaten live, Maximalwerte, Logs, Fehlerspeicher",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 134217728,
    "cpuLimit": 60,
    "memoryThresholdKB": 196608,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "KMMD",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "owner",
  "license": "SEE LICENSE IN LICENSE",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID8"
  ],
  "mguAppStartType": "autostart"
}
